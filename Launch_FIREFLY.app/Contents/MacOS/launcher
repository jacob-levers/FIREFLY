#!/bin/bash
# FIREFLY — macOS launcher
#
# On first run (or after a dependency change) this script:
#   1. detects a missing or stale virtual environment,
#   2. opens a Terminal window where the user can watch pip install
#      progress live — installs take 3–8 minutes on first run depending on
#      network speed because PySide6 + PyTorch are large wheels,
#   3. launches FIREFLY when the install finishes.
#
# A fingerprint of pyproject.toml + the Python ABI detects dependency changes
# after `git pull`; `pip check` catches a damaged environment.

set -eu

# Resolve the project folder.  Launch_sptPALM.app/Contents/MacOS/launcher
# is the executable; the project root sits three levels above it.
FOLDER="$(cd "$(dirname "$0")/../../.." && pwd)"
APP="$FOLDER/run_firefly.py"
VENV="$FOLDER/sptpalm-env"
VENV_PY="$VENV/bin/python3"
FINGERPRINT_SCRIPT="$FOLDER/scripts/dependency_fingerprint.py"
IMPORT_CHECK="$FOLDER/scripts/runtime_import_check.py"
STAMP="$VENV/.firefly-deps.sha256"

# Helper: GUI alert (dialog) via osascript
alert() {
    /usr/bin/osascript -e \
        "display alert \"FIREFLY\" message \"$1\" buttons {\"OK\"} default button \"OK\""
}

# ── Sanity check: project files in place ─────────────────────────────────────
if [ ! -f "$APP" ]; then
    alert "FIREFLY files not found at $FOLDER. Re-extract the FIREFLY folder and try again."
    exit 1
fi

# ── Detect system Python ─────────────────────────────────────────────────────
SYS_PY="$(command -v python3 2>/dev/null || true)"
if [ -z "$SYS_PY" ]; then
    alert "Python 3 is not installed. Install it from https://www.python.org/downloads/ and try again."
    exit 1
fi

# ── Check if the venv matches this checkout ──────────────────────────────────
# An import of one package cannot detect a venv left behind by `git pull` without
# a newly-added runtime dependency.
NEEDS_SETUP=0
if [ ! -f "$VENV_PY" ]; then
    NEEDS_SETUP=1
elif ! CURRENT_FINGERPRINT="$("$VENV_PY" "$FINGERPRINT_SCRIPT" 2>/dev/null)"; then
    NEEDS_SETUP=1
elif [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$CURRENT_FINGERPRINT" ]; then
    NEEDS_SETUP=1
elif ! "$VENV_PY" "$IMPORT_CHECK" >/dev/null 2>&1; then
    NEEDS_SETUP=1
elif ! "$VENV_PY" -m pip check >/dev/null 2>&1; then
    NEEDS_SETUP=1
fi

# ── First-time setup (or upgrade) ────────────────────────────────────────────
if [ "$NEEDS_SETUP" -eq 1 ]; then
    # Open a Terminal so the user can SEE pip install progress.  Without
    # this the launcher would appear frozen for ~5 minutes during a big
    # PySide6 + PyTorch download.
    /usr/bin/osascript <<EOF
tell application "Terminal"
    activate
    do script "set -e; cd '$FOLDER'; \
        echo ''; \
        echo '────────────────────────────────────────────────'; \
        echo '  FIREFLY setup / dependency update'; \
        echo '  Installs PySide6, PyTorch, scipy, and FIREFLY.'; \
        echo '  Expect 3-8 minutes depending on network speed.'; \
        echo '────────────────────────────────────────────────'; \
        echo ''; \
        if [ ! -d sptpalm-env ]; then \
            echo '> python3 -m venv sptpalm-env'; \
            python3 -m venv sptpalm-env; \
        fi; \
        echo '> upgrading pip'; \
        sptpalm-env/bin/python3 -m pip install --upgrade pip; \
        echo ''; \
        echo '> installing the current FIREFLY package and dependencies'; \
        sptpalm-env/bin/python3 -m pip install -e .; \
        sptpalm-env/bin/python3 scripts/runtime_import_check.py; \
        sptpalm-env/bin/python3 -m pip check; \
        CURRENT_FINGERPRINT=\$(sptpalm-env/bin/python3 scripts/dependency_fingerprint.py); \
        printf '%s\\n' \"\$CURRENT_FINGERPRINT\" > sptpalm-env/.firefly-deps.sha256; \
        echo ''; \
        echo '────────────────────────────────────────────────'; \
        echo '  Setup complete — launching FIREFLY...'; \
        echo '────────────────────────────────────────────────'; \
        echo ''; \
        FIREFLY_UI=qml sptpalm-env/bin/python3 run_firefly.py"
end tell
EOF
    exit 0
fi

# ── Normal launch ────────────────────────────────────────────────────────────
# FIREFLY_UI=qml is retained for compatibility with older launch scripts.
cd "$FOLDER"
exec env FIREFLY_UI=qml "$VENV_PY" "$APP"
